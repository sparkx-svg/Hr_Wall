# Copy this file to .env and fill in your deployed function URL.
# Never commit your real .env file.

VITE_AI_API_URL=https://us-central1-YOUR-PROJECT-ID.cloudfunctions.net/aiAssistant

# Firebase config for Google + email/password sign-in.
# Firebase Console -> Project Settings -> General -> "Your apps" -> SDK setup and configuration.
# These values are safe to expose in a frontend build; they are not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Password for the hidden Member Directory admin panel (open the app
# and go to #admin). This only gates the UI in the browser — the real
# write permission is enforced server-side in firestore.rules via an
# admin UID allow-list, so you must also add your Firebase Auth UID
# there for Approve/Reject/Revoke to actually work.
VITE_ADMIN_PASSWORD=
